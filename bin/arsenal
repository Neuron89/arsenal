}

# ---- preview mode: render the detail pane for a given tool name -----------------
if [[ "${1:-}" == "--preview" ]]; then
  want="${2:-}"
  # Wrap to the preview pane's actual width (fzf exports it); leave a small margin.
  W="${FZF_PREVIEW_COLUMNS:-46}"; (( W < 24 )) && W=24
  wrap=$(( W - 2 )); (( wrap < 20 )) && wrap=20
  div="$(printf '─%.0s' $(seq 1 "$W"))"
  bold=$'\e[1m'; dim=$'\e[2m'; cyan=$'\e[36m'; green=$'\e[32m'; yellow=$'\e[33m'; blue=$'\e[34m'; rst=$'\e[0m'
  while IFS='|' read -r cat name cmd kind blurb example; do
    [[ "$name" == "$want" ]] || continue
    printf '%s%s%s\n%s%s%s\n%s%s%s\n\n' "$bold$cyan" "$name" "$rst" "$dim" "$cat" "$rst" "$dim" "$div" "$rst"

    printf '%s%sGood for%s\n' "$bold" "$green" "$rst"
    printf '%s\n\n' "$blurb" | fold -s -w "$wrap"

    cmdpath="$(command -v "$cmd" 2>/dev/null || echo '(not found)')"
    printf '%s%sBinary%s\n%s\n\n' "$bold" "$blue" "$rst" "$cmdpath"

    if [[ -n "$example" ]]; then
      printf '%s%sExample%s\n%s' "$bold" "$yellow" "$rst" "$yellow"
      printf '%s\n' "$example" | fold -s -w "$wrap"
      printf '%s\n' "$rst"
    fi

    printf '%s%sLaunch%s\n' "$bold" "$green" "$rst"
    case "$kind" in
      gui) msg="GUI app. ENTER opens a launch menu: run it, or open the man page." ;;
      *)   msg="Terminal app. ENTER opens a launch menu — help (default), run the example, a custom command, copy to clipboard, or the man page." ;;
    esac
    printf '%s\n' "$msg" | fold -s -w "$wrap"
    exit 0
  done < <(DATA)
  exit 0
fi

# ---- main: build the list, pick, and launch ------------------------------------
command -v fzf >/dev/null || { echo "arsenal: fzf is required" >&2; exit 1; }

# Resolve our own path so the fzf preview re-invokes THIS file, whether it was
# run from the repo, a symlink, or an install on PATH.
SELF="$(realpath -- "$0" 2>/dev/null || echo "$0")"

# Build fzf input: hidden name in col1 (for preview lookup), pretty display after.
build_list() {
  while IFS='|' read -r cat name cmd kind blurb example; do
    # tab-delimited: {1}=name(key)  {2}=category  {3}=name  {4}=full blurb
    printf '%s\t%-16s\t%-18s\t%s\n' "$name" "$cat" "$name" "$blurb"
  done < <(DATA)
}

pause() { echo; IFS= read -rsn1 -p "── press any key to return ──" _ || true; echo; }

# Show a tool's own help/usage in a pager. Terminal tools differ on the flag, so
# probe --help and -h and keep the meatier output; a few are too interactive to
# probe safely and go straight to the man page.
show_help() {
  local c="$1" a b out=""
  case "$c" in
    medusa|john)          out="$(timeout 15 "$c" 2>&1)" ;;   # print usage with no args
    testdisk|netdiscover) out="" ;;                          # would launch — use man
    *)
      a="$(timeout 15 "$c" --help 2>&1)"
      b="$(timeout 15 "$c" -h     2>&1)"
      (( ${#a} >= ${#b} )) && out="$a" || out="$b"
      ;;
  esac
  [[ -z "${out// }" ]] && out="$(man "$c" 2>/dev/null | col -bx)"
  if [[ -z "${out// }" ]]; then
    printf '\e[31mNo built-in help for %s — try the man page or run it directly.\e[0m\n' "$c"
    pause; return
  fi
  { printf '\e[1;36m# %s — help  (q to quit)\e[0m\n\n' "$c"; printf '%s\n' "$out"; } | less -R
}

show_man() {
  if man "$1" >/dev/null 2>&1; then man "$1"; else
    printf '\e[31mNo man page for %s.\e[0m\n' "$1"; pause
  fi
}

# Prefill an editable command line (readline), run it, keep output on screen.
run_editable() {
  printf '\e[1;33mEdit the command, ENTER to run · Ctrl-C to cancel:\e[0m\n'
  local line=""
  IFS= read -e -i "$1" -r line || true
  if [[ -n "${line//[[:space:]]/}" ]]; then printf '\n'; eval "$line" || true; fi
  pause
}

# Clipboard: prefer Wayland (wl-copy), fall back to X11 (xclip/xsel).
have_clip() {
  command -v wl-copy >/dev/null 2>&1 || command -v xclip >/dev/null 2>&1 \
    || command -v xsel >/dev/null 2>&1
}
clip_copy() {  # reads from stdin
  if   command -v wl-copy >/dev/null 2>&1; then wl-copy
  elif command -v xclip   >/dev/null 2>&1; then xclip -selection clipboard
  elif command -v xsel    >/dev/null 2>&1; then xsel --clipboard --input
  else return 1; fi
}

# Build a command line and copy it to the clipboard instead of running it.
copy_cmd() {
  printf '\e[1;35mEdit the command, ENTER to copy · Ctrl-C to cancel:\e[0m\n'
  local line=""
  IFS= read -e -i "$1" -r line || true
  if [[ -z "${line//[[:space:]]/}" ]]; then pause; return; fi
  if have_clip && printf '%s' "$line" | clip_copy; then
    printf '\e[32m✓ copied to clipboard:\e[0m %s\n' "$line"
  else
    printf '\e[31mNo clipboard tool found (install wl-clipboard, xclip, or xsel).\e[0m\n'
    printf 'Command was:\n%s\n' "$line"
  fi
  pause
}

spawn_gui() {
  printf '\e[32mLaunching %s…\e[0m\n' "$name"
  setsid nohup "$cmd" >/dev/null 2>&1 < /dev/null &
  disown 2>/dev/null || true
  sleep 0.4
}

# The "how do you want to launch this?" menu. Terminal tools default to Help
# (first row = fzf's initial cursor); GUI tools default to Launch.
action_menu() {
  local -a opts
  if [[ "$kind" == gui ]]; then
    opts=(
      "launch|▶  Launch $name"
      "man|📖  Open the man page"
      "back|←  Back to the tool list"
    )
  else
    opts=(
      "help|❓  Show help / usage         (default)"
      "example|▶  Run the example command"
      "custom|⌨  Type a custom command"
      "copy|📋  Copy a command to clipboard"
      "man|📖  Open the man page"
      "back|←  Back to the tool list"
    )
  fi
  printf '%s\n' "${opts[@]}" \
    | fzf --ansi --delimiter='|' --with-nth=2 --no-preview \
          --prompt="  $name ❯ " \
          --header=$'choose how to launch — ESC goes back\n' \
          --height='~45%' --layout=reverse --border=rounded --info=hidden \
    | cut -d'|' -f1
}

# Loop the action menu for the selected tool until Back/ESC.
launch_tool() {
  local action
  while true; do
    action="$(action_menu)"
    case "${action:-back}" in
      back)    return ;;
      launch)  spawn_gui; return ;;
      help)    show_help "$cmd" ;;
      man)     show_man "$cmd" ;;
      example) run_editable "${example:-$cmd }" ;;
      custom)  run_editable "$cmd " ;;
      copy)    copy_cmd "${example:-$cmd }" ;;
    esac
  done
}

# Persistent launcher: keep showing the tool list until ESC / empty selection.
while true; do
  sel="$(build_list | sort -t$'\t' -k2,2 -k3,3 \
    | fzf --ansi --delimiter='\t' --with-nth=2,3,4 \
          --nth=2,3 \
          --prompt='  arsenal ❯ ' \
          --header=$'↑↓ browse · type to filter · ENTER = launch options · ESC quit\n' \
          --height=100% --layout=reverse --border=rounded --info=inline \
          --preview="\"$SELF\" --preview {1}" \
          --preview-window='right,34%,wrap,border-left' \
    || true)"

  [[ -z "$sel" ]] && break            # ESC or nothing picked → exit the launcher
  pick="$(printf '%s' "$sel" | cut -f1)"

  # Look the record up via awk so the loop's stdin stays the terminal — otherwise
  # the interactive `read -e` inside would steal from the data stream.
  record="$(DATA | awk -F'|' -v p="$pick" '$2==p {print; exit}')"
  [[ -z "$record" ]] && continue
  IFS='|' read -r cat name cmd kind blurb example <<<"$record"

  if ! command -v "$cmd" >/dev/null 2>&1; then
    printf '\e[31marsenal: "%s" is not on PATH.\e[0m\n' "$cmd"; pause; continue
  fi

  launch_tool
done
