#!/usr/bin/env bash
# arsenal — a categorized fzf launcher for the pentest toolkit.
# Usage: arsenal            → browse & launch
#        arsenal --preview NAME   (internal: renders the preview pane)
#
# Data model, one record per line:  category | name | command | kind | blurb | example
#   kind: gui = launch detached | cli = prefill an editable command line | tui = run as-is
# Keep the table the single source of truth; both the list and the preview read it.

set -uo pipefail   # NOT -e: tools exiting non-zero must not kill the launcher

DATA() {
cat <<'EOF'
Recon / OSINT|nmap|nmap|cli|The workhorse port scanner & service/OS fingerprinter. Start every engagement here.|nmap -sVC -oA scan/TARGET TARGET
